{
  "name": "koishi-plugin-pixiv-parse",
  "description": "提供 Pixiv 链接解析与订阅功能的插件，支持 原图/合并转发/PDF 多种发送方式。现已支持Chatluna工具调用。",
  "version": "0.4.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "author": "WhiteBr1ck (https://github.com/WhiteBr1ck)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteBr1ck/koishi-plugin-pixiv-parse.git"
  },
  "bugs": {
    "url": "https://github.com/WhiteBr1ck/koishi-plugin-pixiv-parse/issues"
  },
  "homepage": "https://github.com/WhiteBr1ck/koishi-plugin-pixiv-parse#readme",
  "keywords": [
    "koishi",
    "plugin",
    "pixiv",
    "解析",
    "订阅",
    "parse",
    "subscription"
  ],
  "koishi": {
    "service": {
      "required": [
        "database"
      ],
      "optional": [
        "puppeteer",
        "console",
        "ffmpeg",
        "chatluna"
      ]
    },
    "description": {
      "zh": "*现已支持Chatluna工具调用*全能 Pixiv 插件，支持解析/下载/转PDF/订阅/随机/GIF发送。"
    }
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.0",
    "koishi": "^4.18.7",
    "koishi-plugin-chatluna": "*",
    "koishi-plugin-ffmpeg": "^1.1.0",
    "koishi-plugin-puppeteer": "*"
  },
  "peerDependenciesMeta": {
    "@koishijs/plugin-console": {
      "optional": true
    },
    "koishi-plugin-chatluna": {
      "optional": true
    },
    "koishi-plugin-ffmpeg": {
      "optional": true
    }
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "adm-zip": "^0.5.16",
    "pdfkit": "^0.19.1",
    "sharp": "^0.33.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.4",
    "@types/pdfkit": "^0.17.6"
  },
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "node -e \"import('@koishijs/client/lib').then(({ build }) => build(process.cwd()))\"",
    "watch": "tsc -w"
  }
}
